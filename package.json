{
  "name": "spectro",
  "version": "2.0.0",
  "description": "Spectro - Personal subscription-powered AI overlay",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "test:ui": "playwright test",
    "test:live": "node scripts/live-check.cjs",
    "test:conversation": "node scripts/conversation-check.cjs",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac --arm64",
    "dist:win": "electron-builder --win",
    "test:privacy": "node scripts/privacy-check.cjs"
  },
  "keywords": [],
  "author": "Tonya",
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "electron": "44.9.1",
    "electron-builder": "26.15.3"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.304",
    "dompurify": "3.4.17",
    "electron-store": "12.0.0",
    "markdown-it": "15.0.3",
    "mathjax": "^3.2.2",
    "node-machine-id": "^1.1.12"
  },
  "build": {
    "appId": "com.yourapp.spectro",
    "productName": "Spectro",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "index.html",
      "style.css",
      "renderer.js",
      "math-config.js",
      "render-content.js",
      "settings.html",
      "preload_settings.js",
      "settings.js",
      "node_modules/**/*",
      "!node_modules/@anthropic-ai/claude-agent-sdk/vendor/**/*"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
